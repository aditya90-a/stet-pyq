{
  "name": "stet-pyq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Previous-year question apps (mobile-first PWA): Bihar STET Computer Science and DSSSB TGT Computer Science, built from the source PDFs.",
  "scripts": {
    "pipeline": "PYTHONPATH=pipeline .venv/bin/python -m stet.build --src /Users/apple/Documents/Stet",
    "pipeline:test": "cd pipeline && ../.venv/bin/python -m pytest -q",
    "pipeline:dsssb": "PYTHONPATH=pipeline .venv/bin/python -m dsssb.build --src /Users/apple/Documents/TGT-DSSSB",
    "pipeline:dsssb:prep": "PYTHONPATH=pipeline .venv/bin/python -m dsssb.prep --src /Users/apple/Documents/TGT-DSSSB",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
